{
  "manifest_version": 3,
  "name": "Asesor IA",
  "version": "2.0.0",
  "description": "Recomienda modelo, estima tokens, te pregunta lo que falta y mejora tu prompt. Aprende de ti. Todo local.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": { "default_title": "Abrir Asesor IA en el panel lateral" },
  "permissions": ["storage", "sidePanel"],
  "background": { "service_worker": "bg.js" },
  "side_panel": { "default_path": "index.html" },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["advisor.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
